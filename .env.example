# El mismo JSON de service account que ya está en la variable
# FIREBASE_SERVICE_ACCOUNT_JSON de Netlify (proyecto LUXDRA PRO FINALIZADO)
# — copiar el valor tal cual, es el mismo Firebase.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Secreto compartido entre este gateway y las Netlify Functions que lo llaman.
# Generar uno random (ej: openssl rand -hex 32) y poner el MISMO valor acá y
# en la variable GATEWAY_SECRET de Netlify.
GATEWAY_SECRET=

# Railway define PORT solo — no hace falta setearla a mano en producción.
PORT=3000
